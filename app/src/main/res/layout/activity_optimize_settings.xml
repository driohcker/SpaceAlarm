<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FAFAFA">

    <!-- 图标 -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/icon"
        android:layout_marginBottom="40dp"
        android:contentDescription="应用图标" />

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="优化设置"
        android:textSize="24sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- 说明文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="为了确保空间闹钟能够正常工作并及时提醒您，建议完成以下设置：\n（此页面仅在首次启动时显示，该功能后续可以设置关闭）"
        android:textSize="14sp"
        android:textColor="#666666"
        android:lineSpacingExtra="8dp"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:textAlignment="center" />

    <!-- 设置项列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="60dp">
        
        <!-- 自启动设置 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/autostart_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="开启应用自启动"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_background_blue"
            android:textAllCaps="false"
            android:gravity="center"
            android:layout_marginHorizontal="2dp"
            android:layout_marginBottom="16dp" />

        <!-- 省电策略设置 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/battery_opt_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="设置省电策略为无限制"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_background_blue"
            android:textAllCaps="false"
            android:layout_marginHorizontal="2dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 继续按钮 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/continue_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="设置后继续"
        android:textSize="16sp"
        android:textColor="#333"
        android:background="@drawable/rounded_background_white_2"
        android:layout_marginHorizontal="2dp"
        android:textAllCaps="false" />

</LinearLayout>